# Setting names. On Google Cloud Run, keys go in Secret Manager (see README); on Vercel, in Settings > Environment Variables.
# Never commit real values.
OPENAI_API_KEY=
# DEMO_PASSCODE=   (optional; leave out for an open link)
# LIMIT_PER_HOUR=150
# LIMIT_PER_DAY=3000
# MODEL=gpt-6.1-terra
# REASONING_EFFORT=low
# TRANSCRIBE_MODEL=gpt-transcribe
# TTS_MODEL=gpt-realtime-2.1-mini
# TTS_VOICE=marin
# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Upstash Redis (shared limits and WhatsApp conversations)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CHAT_TTL_HOURS=24
